<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 312 260" width="312" height="260">
  <defs>
    <linearGradient id="bodyGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2a2e3d"/>
      <stop offset="50%" stop-color="#181a24"/>
      <stop offset="100%" stop-color="#0e1017"/>
    </linearGradient>
    <linearGradient id="neonCyan" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#3b82f6"/>
      <stop offset="100%" stop-color="#60a5fa"/>
    </linearGradient>
    <linearGradient id="exhaustGrad" x1="0%" y1="0%" x2="100%" y2="30%">
      <stop offset="0%" stop-color="#64748b"/>
      <stop offset="50%" stop-color="#94a3b8"/>
      <stop offset="100%" stop-color="#3b82f6"/>
    </linearGradient>
    <linearGradient id="visorGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#60a5fa"/>
      <stop offset="100%" stop-color="#93c5fd"/>
    </linearGradient>
    <filter id="glowLight" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="4" result="blur" />
      <feComposite in="SourceGraphic"2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Rear swingarm and suspension -->
  <path d="M 60 215 L 120 185 L 140 210 Z" fill="#242833" stroke="#374151" stroke-width="2"/>
  <line x1="100" y1="165" x2="80" y2="205" stroke="#60a5fa" stroke-width="4" stroke-dasharray="2,3"/>

  <!-- Exhaust pipes -->
  <path d="M 125 185 C 105 185 85 200 45 205 L 42 195 C 80 190 100 175 120 175 Z" fill="url(#exhaustGrad)"/>
  <ellipse cx="44" cy="200" rx="3" ry="5" fill="#f87171" opacity="0.8"/>

  <!-- Engine Block -->
  <rect x="110" y="150" width="55" height="42" rx="4" fill="#1f242d" stroke="#374151" stroke-width="1.5"/>
  <line x1="114" y1="158" x2="160" y2="158" stroke="#4b5563" stroke-width="2"/>
  <line x1="114" y1="166" x2="160" y2="166" stroke="#4b5563" stroke-width="2"/>
  <line x1="114" y1="174" x2="160" y2="174" stroke="#4b5563" stroke-width="2"/>
  <circle cx="138" cy="180" r="8" fill="#111827" stroke="#60a5fa" stroke-width="1.5"/>

  <!-- Frame Trellis -->
  <path d="M 100 150 L 140 120 L 195 130 L 170 185 L 120 185 Z" fill="none" stroke="#2563eb" stroke-width="3" opacity="0.6"/>

  <!-- Front Fork -->
  <line x1="225" y1="130" x2="265" y2="218" stroke="#94a3b8" stroke-width="5" stroke-linecap="round"/>
  <line x1="220" y1="130" x2="260" y2="218" stroke="#475569" stroke-width="3"/>
  <circle cx="265" cy="218" r="6" fill="#1e293b" stroke="#60a5fa" stroke-width="2"/>

  <!-- Handlebars & Triple clamp -->
  <path d="M 218 118 L 226 128 L 210 135" fill="none" stroke="#e2e8f0" stroke-width="3" stroke-linecap="round"/>
  <circle cx="208" cy="136" r="4" fill="#3b82f6"/>

  <!-- Headlight beam & cowl -->
  <path d="M 230 125 L 255 138 L 245 155 L 226 142 Z" fill="#1e293b" stroke="#3b82f6" stroke-width="1.5"/>
  <polygon points="252,138 310,132 312,156 246,152" fill="url(#neonCyan)" opacity="0.2" filter="url(#glowLight)"/>
  <line x1="250" y1="139" x2="246" y2="151" stroke="#93c5fd" stroke-width="3" filter="url(#glowLight)"/>

  <!-- Main Body Tank and Tail -->
  <path d="M 65 142 C 90 142 105 135 125 130 C 145 115 175 112 210 120 C 220 123 226 130 220 140 C 200 150 170 152 145 155 C 105 156 80 155 65 142 Z" fill="url(#bodyGrad)" stroke="#3b82f6" stroke-width="1.5"/>
  <path d="M 130 126 C 155 118 180 118 205 124" fill="none" stroke="url(#neonCyan)" stroke-width="2.5"/>

  <!-- Tail Fairing -->
  <path d="M 60 145 L 90 145 L 85 135 L 55 136 Z" fill="#1e2430" stroke="#374151" stroke-width="1"/>
  <rect x="52" y="137" width="4" height="6" rx="1" fill="#ef4444" filter="url(#glowLight)"/>

  <!-- Rider Body (Leaning Forward) -->
  <!-- Legs / Boot -->
  <path d="M 108 148 C 115 160 125 172 135 180 L 125 186 C 112 176 100 162 95 148 Z" fill="#111827" stroke="#1f2937" stroke-width="1.5"/>
  <polygon points="122,184 135,180 140,188 126,190" fill="#0f172a" stroke="#60a5fa" stroke-width="1"/>

  <!-- Torso & Jacket -->
  <path d="M 100 142 C 102 125 115 105 145 98 C 172 92 195 100 205 118 C 190 125 175 125 145 128 C 120 130 108 138 100 142 Z" fill="#181c26" stroke="#2563eb" stroke-width="1.5"/>
  <path d="M 125 115 L 165 104" stroke="#60a5fa" stroke-width="2" opacity="0.7"/>

  <!-- Arm reaching forward to handlebars -->
  <path d="M 165 106 C 180 112 195 120 208 134" fill="none" stroke="#1e2433" stroke-width="8" stroke-linecap="round"/>
  <path d="M 165 106 C 180 112 195 120 208 134" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" opacity="0.6"/>
  <circle cx="208" cy="134" r="5" fill="#0f172a" stroke="#93c5fd" stroke-width="1"/>

  <!-- Rider Helmet & Head -->
  <path d="M 180 82 C 180 68 198 62 215 68 C 228 73 234 85 230 96 C 222 104 205 105 190 100 C 182 95 180 88 180 82 Z" fill="#0f172a" stroke="#3b82f6" stroke-width="1.5"/>
  <!-- Visor -->
  <path d="M 212 75 C 225 78 228 85 225 92 C 218 94 208 92 208 86 Z" fill="url(#visorGrad)" filter="url(#glowLight)"/>
  <line x1="214" y1="78" x2="225" y2="85" stroke="#ffffff" stroke-width="1.5" opacity="0.8"/>
</svg>
