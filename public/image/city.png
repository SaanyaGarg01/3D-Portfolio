<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 186" width="1000" height="186">
  <defs>
    <linearGradient id="bldgGrad1" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#374151"/>
      <stop offset="100%" stop-color="#111827"/>
    </linearGradient>
    <linearGradient id="bldgGrad2" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#4b5563"/>
      <stop offset="100%" stop-color="#1f2937"/>
    </linearGradient>
    <pattern id="winPat" width="6" height="8" patternUnits="userSpaceOnUse">
      <rect x="1" y="1" width="2" height="3" fill="#60a5fa" opacity="0.35"/>
    </pattern>
    <pattern id="winPatDim" width="8" height="10" patternUnits="userSpaceOnUse">
      <rect x="2" y="2" width="2" height="4" fill="#93c5fd" opacity="0.2"/>
    </pattern>
  </defs>

  <!-- Far layer silhouette -->
  <g fill="#1f2430" opacity="0.45">
    <rect x="0" y="80" width="45" height="106"/>
    <polygon points="45,186 45,60 65,40 85,60 85,186"/>
    <rect x="85" y="95" width="50" height="91"/>
    <rect x="135" y="70" width="70" height="116"/>
    <polygon points="205,186 205,50 225,25 245,50 245,186"/>
    <rect x="245" y="85" width="65" height="101"/>
    <rect x="310" y="60" width="55" height="126"/>
    <polygon points="365,186 365,45 385,20 405,45 405,186"/>
    <line x1="385" y1="20" x2="385" y2="5" stroke="#ef4444" stroke-width="2"/>
    <circle cx="385" cy="5" r="2" fill="#ef4444"/>
    <rect x="405" y="75" width="80" height="111"/>
    <rect x="485" y="55" width="60" height="131"/>
    <rect x="545" y="90" width="70" height="96"/>
    <polygon points="615,186 615,40 635,15 655,40 655,186"/>
    <rect x="655" y="70" width="65" height="116"/>
    <rect x="720" y="50" width="55" height="136"/>
    <polygon points="775,186 775,65 795,45 815,65 815,186"/>
    <rect x="815" y="80" width="75" height="106"/>
    <polygon points="890,186 890,35 910,10 930,35 930,186"/>
    <rect x="930" y="65" width="70" height="121"/>
  </g>

  <!-- Mid/foreground detailed skyline -->
  <rect x="20" y="100" width="50" height="86" fill="url(#bldgGrad1)"/>
  <rect x="24" y="105" width="42" height="75" fill="url(#winPat)"/>

  <polygon points="90,186 90,65 110,45 130,65 130,186" fill="url(#bldgGrad2)"/>
  <line x1="110" y1="45" x2="110" y2="15" stroke="#94a3b8" stroke-width="1.5"/>
  <circle cx="110" cy="15" r="2" fill="#ef4444"/>
  <rect x="96" y="72" width="28" height="100" fill="url(#winPatDim)"/>

  <rect x="145" y="85" width="60" height="101" fill="url(#bldgGrad1)"/>
  <rect x="150" y="92" width="50" height="88" fill="url(#winPat)"/>

  <rect x="220" y="110" width="70" height="76" fill="url(#bldgGrad2)"/>
  <rect x="230" y="75" width="50" height="35" fill="url(#bldgGrad2)"/>
  <rect x="240" y="50" width="30" height="25" fill="url(#bldgGrad2)"/>
  <line x1="255" y1="50" x2="255" y2="25" stroke="#60a5fa" stroke-width="2"/>
  <rect x="225" y="115" width="60" height="65" fill="url(#winPat)"/>

  <polygon points="315,186 322,40 338,40 345,186" fill="#1e293b"/>
  <line x1="280" y1="120" x2="330" y2="60" stroke="#475569" stroke-width="1.5"/>
  <line x1="330" y1="60" x2="380" y2="120" stroke="#475569" stroke-width="1.5"/>
  <line x1="290" y1="130" x2="330" y2="80" stroke="#475569" stroke-width="1"/>
  <line x1="330" y1="80" x2="370" y2="130" stroke="#475569" stroke-width="1"/>

  <rect x="390" y="70" width="55" height="116" fill="url(#bldgGrad1)"/>
  <polygon points="390,70 417,30 445,70" fill="url(#bldgGrad1)"/>
  <line x1="417" y1="30" x2="417" y2="8" stroke="#38bdf8" stroke-width="2"/>
  <circle cx="417" cy="8" r="2.5" fill="#38bdf8"/>
  <rect x="396" y="76" width="43" height="100" fill="url(#winPat)"/>

  <rect x="460" y="95" width="65" height="91" fill="url(#bldgGrad2)"/>
  <rect x="468" y="102" width="49" height="78" fill="url(#winPatDim)"/>

  <polygon points="545,186 545,80 555,55 585,55 595,80 595,186" fill="url(#bldgGrad1)"/>
  <rect x="560" y="30" width="20" height="25" fill="#374151"/>
  <line x1="570" y1="30" x2="570" y2="12" stroke="#e0e7ff" stroke-width="2"/>
  <rect x="552" y="85" width="36" height="95" fill="url(#winPat)"/>

  <polygon points="620,186 620,60 670,90 670,186" fill="url(#bldgGrad2)"/>
  <rect x="625" y="75" width="40" height="105" fill="url(#winPat)"/>

  <rect x="690" y="80" width="60" height="106" fill="url(#bldgGrad1)"/>
  <polygon points="690,80 720,40 750,80" fill="url(#bldgGrad1)"/>
  <line x1="720" y1="40" x2="720" y2="18" stroke="#ef4444" stroke-width="1.5"/>
  <rect x="698" y="88" width="44" height="92" fill="url(#winPatDim)"/>

  <rect x="765" y="120" width="75" height="66" fill="url(#bldgGrad2)"/>
  <rect x="772" y="126" width="61" height="54" fill="url(#winPat)"/>

  <polygon points="855,186 855,65 875,35 895,65 895,186" fill="url(#bldgGrad1)"/>
  <line x1="875" y1="35" x2="875" y2="10" stroke="#60a5fa" stroke-width="2"/>
  <circle cx="875" cy="10" r="2.5" fill="#ef4444"/>
  <rect x="862" y="72" width="26" height="108" fill="url(#winPat)"/>

  <rect x="910" y="90" width="70" height="96" fill="url(#bldgGrad2)"/>
  <rect x="918" y="98" width="54" height="82" fill="url(#winPatDim)"/>
  <rect x="980" y="100" width="20" height="86" fill="url(#bldgGrad1)"/>
</svg>
